# Conexión a la base de datos Neon (Postgres serverless).
# La consigues en tu proyecto de Neon: Dashboard -> Connection string
# (elige "Pooled connection" para mejor rendimiento en serverless).
DATABASE_URL=postgresql://usuario:password@ep-xxxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

